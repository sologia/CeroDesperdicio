# Copia este archivo como .env y deja sin # SOLO una de las opciones.
# Sin clave, la app usa recetas locales (modo sin conexión).

# --- Opción 1: Google Gemini (GRATIS, recomendada) ---
# Clave en: https://aistudio.google.com/apikey
OPENAI_API_KEY=pega_aqui_tu_clave_de_gemini
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Varios modelos separados por coma: si uno falla se usa el siguiente.
OPENAI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash

# --- Opción 2: Groq (GRATIS) ---
# Clave en: https://console.groq.com/keys
# OPENAI_API_KEY=pega_aqui_tu_clave_de_groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- Opción 3: Ollama (GRATIS, en tu PC, sin internet) ---
# Instala Ollama y ejecuta: ollama pull llama3.1
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# --- Opción 4: OpenAI (de pago) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5

# Límite de tokens de la respuesta (incluye el razonamiento del modelo).
OPENAI_MAX_TOKENS=12000
